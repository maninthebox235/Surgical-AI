# Database
DATABASE_URL=postgresql://user:password@localhost:5432/surgical_education

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Auth0 (API access-token verification via PyJWT + JWKS)
# AUTH0_DOMAIN: tenant host only (no https://), e.g. your-tenant.auth0.com
# AUTH0_AUDIENCE: Auth0 API identifier (JWT aud claim)
# JWKS is loaded from https://<AUTH0_DOMAIN>/.well-known/jwks.json
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=your-api-identifier
# Optional: JWKS in-memory cache TTL in seconds (default 3600)
AUTH0_JWKS_CACHE_TTL_SECONDS=3600
# Optional: cooldown between unknown-kid JWKS refreshes (default 60)
AUTH0_JWKS_UNKNOWN_KID_COOLDOWN_SECONDS=60

# Model
MODEL_WEIGHTS_PATH=/path/to/model/weights.pth
